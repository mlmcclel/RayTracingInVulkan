{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build RayTracer",
      "type": "shell",
      "windows": {
        "command": "cmd.exe",
        "args": ["/c", "${workspaceFolder}\\build_windows.bat"],
        "problemMatcher": "$msCompile"
      },
      "linux": {
        "command": "./build_linux.sh",
        "problemMatcher": "$gcc"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build RayTracer (Windows Debug)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\build_windows.bat", "Debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}